{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookEngine BOOK contract v1",
  "description": "AI-facing BOOK input. Runtime validation also checks unique IDs and cross-references.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bookSpecVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "\\S"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 500
        },
        "author": {
          "type": "string",
          "maxLength": 500
        },
        "audience": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "format": {
          "enum": [
            "textbook",
            "workbook",
            "trainer"
          ],
          "default": "textbook"
        },
        "versionLabel": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "title"
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S"
          },
          "creator": {
            "type": "string",
            "maxLength": 1000
          },
          "year": {
            "type": "string",
            "maxLength": 1000
          },
          "locator": {
            "type": "string",
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "maxLength": 1000,
            "pattern": "^(?:https?://.*)?$"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 30000
          },
          "verified": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    },
    "fiches": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "sourceId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "quote",
              "summary",
              "author"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 1,
            "pattern": "\\S"
          },
          "locator": {
            "type": "string",
            "maxLength": 1000
          },
          "keywords": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "kind",
          "text"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "quote",
                    "summary"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "sourceId"
              ],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "quote"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "locator"
              ],
              "properties": {
                "locator": {
                  "type": "string",
                  "maxLength": 1000,
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S"
          },
          "objectives": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "fichIds": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                },
                "type": {
                  "enum": [
                    "paragraph",
                    "heading",
                    "callout",
                    "exercise",
                    "quote",
                    "list"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 30000
                },
                "sourceId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locator": {
                  "type": "string",
                  "maxLength": 1000
                },
                "rubric": {
                  "type": "string",
                  "maxLength": 5000
                },
                "items": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "maxLength": 3000,
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "lines": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12,
                  "default": 4
                }
              },
              "required": [
                "type"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "list"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "items"
                    ],
                    "properties": {
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "items": {
                          "type": "string",
                          "maxLength": 3000,
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      }
                    }
                  },
                  "else": {
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxLength": 30000,
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "quote"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "sourceId",
                      "locator"
                    ],
                    "properties": {
                      "sourceId": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                      },
                      "locator": {
                        "type": "string",
                        "maxLength": 1000,
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "title",
          "blocks"
        ]
      }
    }
  },
  "required": [
    "bookSpecVersion",
    "metadata",
    "chapters"
  ]
}