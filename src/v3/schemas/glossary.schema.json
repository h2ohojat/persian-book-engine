{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookEngine memory/glossary.yaml (contract 3)",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
      "patternMessage": "شناسه باید انگلیسی، بدون فاصله و حداکثر ۸۰ نویسه باشد."
    }
  },
  "properties": {
    "terms": {
      "type": "array",
      "maxItems": 5000,
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "term"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "term": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 300
          },
          "definition": {
            "type": "string",
            "maxLength": 5000,
            "default": ""
          },
          "english": {
            "type": "string",
            "maxLength": 300
          },
          "avoid": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 300
            }
          }
        }
      }
    }
  }
}
